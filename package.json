{
  "name": "synchroflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The root of the SynchroFlow monorepo.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev-api\" \"npm:dev-cpp\" \"npm:dev-ui\" \"npm:dev-ai\" \"npm:dev-integration\"",
    "dev-api": "wait-on tcp:5432 && npm run dev -w api",
    "dev-cpp": "npm run dev -w core-engine",
    "dev-ui": "wait-on tcp:3000 && npm run dev -w ui",
    "dev-ai": "npm run dev -w ai-engine",
    "dev-integration": "npm run dev -w integration-service",
    "db:reset": "docker exec synchroflow_db psql -U sf_user -d postgres -c 'DROP DATABASE IF EXISTS synchroflow_db;' && docker exec synchroflow_db psql -U sf_user -d postgres -c 'CREATE DATABASE synchroflow_db;'",
    "test:setup": "npm run db:reset && npm run migrate -w api && npm run seed -w api",
    "test": "npm run test:setup && jest --runInBand --verbose --forceExit",
    "test:e2e": "npx playwright test --config=packages/ui/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --config=packages/ui/playwright.config.ts --ui",
    "dev:full": "npm run test:setup && npm run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "babel-preset-vite": "^1.1.3",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-transform-stub": "^2.0.0",
    "nodemon": "^3.1.10",
    "resize-observer-polyfill": "^1.5.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/types": "^7.4.7",
    "amqplib": "^0.10.9",
    "axios": "^1.12.2",
    "react-hooks": "^1.0.1"
  }
}
