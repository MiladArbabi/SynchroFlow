{
  "name": "synchroflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The root of the SynchroFlow monorepo.",
  "workspaces": [
    "packages/api",
    "packages/cpp-core",
    "packages/ui",
    "packages/ai-engine",
    "packages/integration-service"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev-api\" \"npm:dev-cpp\" \"npm:dev-ui\" \"npm:dev-ai\" \"npm:dev-integration\"",
    "dev-api": "npm run dev -w api",
    "dev-cpp": "npm run dev -w cpp-core",
    "dev-ui": "npm run dev -w ui",
    "dev-ai": "npm run dev -w ai-engine",
    "dev-integration": "npm run dev -w integration-service",
    "db:reset": "docker exec synchroflow_db psql -U sf_user -d postgres -c 'DROP DATABASE IF EXISTS synchroflow_db;' && docker exec synchroflow_db psql -U sf_user -d postgres -c 'CREATE DATABASE synchroflow_db;'",
    "test:setup": "npm run db:reset && npm run migrate -w api",
    "test": "npm run test:setup && jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-transform-stub": "^2.0.0",
    "nodemon": "^3.1.10",
    "resize-observer-polyfill": "^1.5.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4"
  },
  "dependencies": {
    "axios": "^1.12.2"
  }
}
