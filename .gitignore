# ----------------------------------------------------------------------
# Node.js/JavaScript Monorepo Files (Highest Priority)
# ----------------------------------------------------------------------
# Standard Node dependency directories (ignore everywhere)
node_modules/
**/node_modules
/packages/**/node_modules

# Build/Artifacts directories
/dist
/build
/out
/apps/*/dist
/apps/*/build

# Package lock files for safety (only exclude if using a monorepo manager like yarn/pnpm, but safe to exclude for now)
# package-lock.json

# Environment files (Critical for Security)
.env
.env.*
!.env.example # Keep the example file
*.log
npm-debug.log*

# ----------------------------------------------------------------------
# IDE and OS Files
# ----------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# ----------------------------------------------------------------------
# C++ / CMake Artifacts
# ----------------------------------------------------------------------
# C++ compilation and dependency files
*.o
*.so
*.a
*.obj
*.lib
*.exe
# CMake build directories
/apps/core-engine/build
/apps/core-engine/CMakeFiles

# Copied build artifacts
+**/dist/**/*.node

# ----------------------------------------------------------------------
# Python / AI Engine Artifacts
# ----------------------------------------------------------------------
# Virtual environment
/apps/ai-engine/venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
# UI Template/Asset directory
material-dashboard-react-main/

# Playwright auth state
playwright/.auth/
playwright-report/
