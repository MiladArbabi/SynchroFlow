# ----------------------------------------------------------------------
# Node.js/JavaScript Monorepo Files (Highest Priority)
# ----------------------------------------------------------------------
# Standard Node dependency directories (ignore everywhere)
node_modules/
**/node_modules
/apps/**/node_modules

# Build/Artifacts directories
/dist
/build
/out
/apps/*/dist
/apps/*/build

# Package lock files for safety (only exclude if using a monorepo manager like yarn/pnpm, but safe to exclude for now)
# package-lock.json

# Environment files (Critical for Security)
.env
apps/frontend/.env
.env.*
!.env.example # Keep the example file
*.log

# ----------------------------------------------------------------------
# IDE and OS Files
# ----------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# ----------------------------------------------------------------------
# C++ / CMake Artifacts
# ----------------------------------------------------------------------
# C++ compilation and dependency files
*.o
*.so
*.a
*.obj
*.lib
*.exe
# CMake build directories
/apps/core-engine/build
/apps/core-engine/CMakeFiles

# Copied build artifacts
+**/dist/**/*.node

# ----------------------------------------------------------------------
# Python / AI Engine Artifacts
# ----------------------------------------------------------------------
# Virtual environment
/apps/ai-engine/venv/
apps/backend/migrations_legacy

# Python cache
__pycache__/
*.py[cod]
*$py.class
# UI Template/Asset directory
material-dashboard-react-main/

# ----------------------------------------------------------------------
# Test Coverage (ABSOLUTELY DO NOT COMMIT)
# ----------------------------------------------------------------------
coverage/
**/coverage/
coverage/**

# Jest / NYC / Istanbul
lcov.info
coverage-final.json
clover.xml
.nyc_output/

# Playwright / test artefacts
playwright-report/
test-results/
playwright/.auth/
playwright-report/

# Build artifacts
/apps/*/dist/
apps/*/dist/**
/apps/**/dist/
/apps/**/dist/**

/modules/*/dist/
modules/*/dist/**
/modules/**/dist/
/modules/**/dist/**

# Vite / frontend build artefacts
/dist/
/build/

# TypeScript build info
*.tsbuildinfo
**/*.tsbuildinfo
tsconfig.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
*.sublime-project
*.sublime-workspace

#claude
.claude/worktrees/

# ----------------------------------------------------------------------
# apps/marketing (Next.js)
# ----------------------------------------------------------------------
apps/marketing/.next/
apps/marketing/out/
apps/marketing/.env*.local
apps/marketing/next-env.d.ts