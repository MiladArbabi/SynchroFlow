# Dependencies
**/node_modules/

# Apps not deployed to Fly
apps/marketing/
apps/mobile/
apps/integration-service/

# Build artifacts & caches (monorepo-wide)
# BUILD-02: workspace dist is generated from source inside the Docker build.
# Do not send local/generated package or module dist into the build context.
packages/*/dist/
modules/*/dist/
apps/*/dist/
apps/**/dist/
**/build/
**/out/
**/.turbo/
**/.next/
**/*.tsbuildinfo

# Local dev data (the 50 MB killer)
dev-db-data/

# Docs
docs/

# Testing & coverage
coverage/
*.test.*
*.spec.*
playwright-report/
test-results/
.nyc_output/

# C++ / Core Engine
apps/core-engine/build/
apps/core-engine/CMakeFiles/
*.o
*.so
*.a
*.obj
*.lib
*.exe

# Python / AI Engine
apps/ai-engine/venv/
__pycache__/
*.py[cod]
*$py.class

# Backend
apps/backend/migrations_legacy/

#Packages
packages/landing-page/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Git, IDE, OS
.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets
.env
.env.*

# Misc
*.md
.claude/
material-dashboard-react-main/
