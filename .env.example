# --- Runtime ---
NODE_ENV=development
HOST=localhost
PORT=3000

# --- PostgreSQL (matches docker inspect) ---
PGHOST=localhost
PGPORT=5432
PGUSER=sf_user
PGPASSWORD=sf_pass
PGDATABASE=synchroflow_db
PGMIGRATION_USER=sf_user
PGMIGRATION_PASSWORD=sf_pass

# Production only: keep these credentials in different security boundaries.
# DATABASE_URL is for local/external migration jobs only and MUST NOT be
# installed as a secret on the Fly runtime app.
# APP_DATABASE_URL must authenticate as restricted role sf_app.
DATABASE_URL=
APP_DATABASE_URL=

# --- Auth ---
JWT_SECRET=dev-jwt-secret
JWT_REFRESH_SECRET=dev-jwt-refresh-secret

# --- URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Shopify (required even in dev) ---
# Copy these values from Shopify Dev Dashboard → Settings → Credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-04

# --- Shopify App Events usage billing ---
# App Events uses the same app credentials as SHOPIFY_API_KEY/SECRET.
# Duplicate the literal secret values in the runtime environment; do not use
# variable references because deployment dotenv implementations may not expand them.
SHOPIFY_APP_EVENTS_CLIENT_ID=
SHOPIFY_APP_EVENTS_CLIENT_SECRET=
SHOPIFY_APP_EVENTS_METER_HANDLE=shipped-order

# --- Encryption ---
ENCRYPTION_KEY=dev-encryption-key-32chars-minimum

# --- Push Notifications (WM-22) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:dev@lasyncro.com
VITE_VAPID_PUBLIC_KEY=

# --- Queue / infra ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

# --- Reviewer activity refresh (OV-153) ---
# Disabled by default. Enable only for the seeded Shopify-review tenant; the
# worker also requires its seed marker and both canonical reviewer operators.
REVIEWER_ACTIVITY_REFRESH_ENABLED=false
REVIEWER_ACTIVITY_REFRESH_SHOP_ID=
