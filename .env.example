# --- Runtime ---
NODE_ENV=development
HOST=localhost
PORT=3000

# --- PostgreSQL (matches docker inspect) ---
PGHOST=localhost
PGPORT=5432
PGUSER=sf_user
PGPASSWORD=sf_pass
PGDATABASE=synchroflow_db

# --- Auth ---
JWT_SECRET=dev-jwt-secret
JWT_REFRESH_SECRET=dev-jwt-refresh-secret

# --- URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Shopify (required even in dev) ---
# Copy these values from Shopify Dev Dashboard → Settings → Credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2024-10

# --- Shopify App Events usage billing ---
# App Events uses the same app credentials as SHOPIFY_API_KEY/SECRET.
# Duplicate the literal secret values in the runtime environment; do not use
# variable references because deployment dotenv implementations may not expand them.
SHOPIFY_APP_EVENTS_CLIENT_ID=
SHOPIFY_APP_EVENTS_CLIENT_SECRET=
SHOPIFY_APP_EVENTS_METER_HANDLE=shipped-order

# --- Encryption ---
ENCRYPTION_KEY=dev-encryption-key-32chars-minimum

# --- Push Notifications (WM-22) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:dev@lasyncro.com
VITE_VAPID_PUBLIC_KEY=

# --- Queue / infra ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379