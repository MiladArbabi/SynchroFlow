{
  "name": "api",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc --project tsconfig.json && cp ../core-engine/build/Release/sf_core.node dist/src",
    "start": "node dist/src/server.js",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node --env-file=../../.env dist/src/server.js\"",
    "seed": "knex seed:run --specific=dev_seed.ts",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:rollback": "knex migrate:rollback"
  },
  "dependencies": {
    "amqp-connection-manager": "^5.0.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-session": "^1.18.2",
    "knex": "^3.1.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
