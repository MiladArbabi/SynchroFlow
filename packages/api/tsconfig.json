{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",      // Include all .ts files in the src directory
    "knexfile.ts",      // Explicitly include knexfile.ts
    "migrations/**/*.ts" // Explicitly include all .ts files in migrations
  ]
}