// packages/ui/tsconfig.json
{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["jest", "@testing-library/jest-dom"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,

    // --- ADDED FOR PATH ALIASES ---
    "baseUrl": "./src", // Sets the base directory for absolute paths
    "paths": {
      // Mirroring Vite aliases for TypeScript IDE support
      "config": ["config.ts"],
      "hooks/*": ["hooks/*"],
      "themes/*": ["themes/*"],
      "utils/*": ["utils/*"],
      "ui-component/*": ["ui-component/*"],
      "layout/*": ["layout/*"],
      "menu-items": ["menu-items/index.ts"], // Point directly to the entry file
      "menu-items/*": ["menu-items/*"],
      "api/*": ["api/*"],
      "assets/*": ["assets/*"],
      "components/*": ["components/*"],
      "contexts/*": ["contexts/*"],
      "layouts/*": ["layouts/*"],
      "routes": ["routes.tsx"]
      // Note: Removed 'context' and 'examples' aliases for simplicity,
      // rely on the broader aliases like 'contexts/*' and 'components/*'
    }
    // --- END ADDED ---
  },
  "include": ["src", "types", "../../types"]
}