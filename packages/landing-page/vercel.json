{
  "installCommand": "echo 'no install needed'",
  "buildCommand": "echo 'no build needed'",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/_next/:path*",
      "destination": "https://synchro-flow-marketing.vercel.app/_next/:path*"
    },
    {
      "source": "/reveal.js",
      "destination": "https://synchro-flow-marketing.vercel.app/reveal.js"
    },
    {
      "source": "/blog",
      "destination": "https://synchro-flow-marketing.vercel.app/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://synchro-flow-marketing.vercel.app/blog/:path*"
    },
    {
      "source": "/about",
      "destination": "https://synchro-flow-marketing.vercel.app/about"
    },
    {
      "source": "/privacy",
      "destination": "https://synchro-flow-marketing.vercel.app/privacy"
    },
    {
      "source": "/compare",
      "destination": "https://synchro-flow-marketing.vercel.app/compare"
    },
    {
      "source": "/compare/:path*",
      "destination": "https://synchro-flow-marketing.vercel.app/compare/:path*"
    },
    {
      "source": "/features/:path*",
      "destination": "https://synchro-flow-marketing.vercel.app/features/:path*"
    },
    {
      "source": "/industries/:path*",
      "destination": "https://synchro-flow-marketing.vercel.app/industries/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://synchro-flow-marketing.vercel.app/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://synchro-flow-marketing.vercel.app/robots.txt"
    },
    {
      "source": "/api/waitlist",
      "destination": "https://synchro-flow-marketing.vercel.app/api/waitlist"
    },
    {
      "source": "/api/shopify-availability",
      "destination": "https://synchro-flow-marketing.vercel.app/api/shopify-availability"
    },
    { "source": "/pricing", "destination": "https://synchro-flow-marketing.vercel.app/pricing" },
    { "source": "/faq", "destination": "https://synchro-flow-marketing.vercel.app/faq" },
    {
      "source": "/help",
      "destination": "https://synchro-flow-marketing.vercel.app/help"
    },
    {
      "source": "/help/:path*",
      "destination": "https://synchro-flow-marketing.vercel.app/help/:path*"
    },
    {
      "source": "/terms",
      "destination": "https://synchro-flow-marketing.vercel.app/terms"
    }
  ],
  "redirects": [
    {
      "source": "/pilot",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/glossary",
      "destination": "/help",
      "permanent": true
    },
    {
      "source": "/glossary/:path*",
      "destination": "/help",
      "permanent": true
    },
    {
      "source": "/getting-started",
      "destination": "/help/getting-started",
      "permanent": true
    }
  ]
}
