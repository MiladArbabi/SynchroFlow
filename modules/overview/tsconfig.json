{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* REQUIRED OVERRIDES — DO NOT REMOVE */
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,

    /* LIBRARY EMIT */
    "rootDir": "src",
    "outDir": "dist",
    /**
    * Standardized ESM mode for monorepo consistency.
    * Required for correct package "exports" resolution.
    */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": true,
    "target": "ES2020",

    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.*"]
}
