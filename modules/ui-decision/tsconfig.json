{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,

    "rootDir": "src",
    "outDir": "dist",

    /**
    * REQUIRED:
    * NodeNext ensures correct resolution of workspace packages
    * and package.json "exports" under ESM.
    */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",

    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,

    "jsx": "react-jsx",
    "composite": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}