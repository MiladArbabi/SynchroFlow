{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "baseUrl": "./",
    "paths": {
      "runtime/*": ["src/runtime-stubs/*"],
      "runtime": ["src/runtime-stubs/index"]
    },
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2020",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.*"]
}
