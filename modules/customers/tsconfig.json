{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    
    /**
    * Standardized ESM mode for monorepo consistency.
    * Required for correct package "exports" resolution.
    */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",

    "declaration": true,
    "sourceMap": true,
    "composite": true,

    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
