{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "moduleResolution": "node",
    "allowImportingTsExtensions": false,
    "isolatedModules": false,

    "rootDir": "src",
    "outDir": "dist",
    "module": "ES2020",
    "target": "ES2020",

    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}