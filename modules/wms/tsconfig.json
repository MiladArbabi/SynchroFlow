{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist/ui",
    "rootDir": "./src/ui",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
    "include": [
      "src/ui/**/*"
    ]
}