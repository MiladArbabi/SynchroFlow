{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    /**
    * REQUIRED for NodeNext resolution.
    * Emits native ESM compatible with Vite/Rollup.
    */
    "module": "NodeNext",
    /**
    * REQUIRED:
    * NodeNext enables proper resolution of package.json "exports"
    * across workspace ESM modules.
    * Do NOT downgrade to "node".
    */
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",

    "declaration": true,
    "sourceMap": true,

    "noEmit": false,
    "emitDeclarationOnly": false,
    "composite": true,

    "allowImportingTsExtensions": false
  },
  "include": [ "src/**/*"],
  "references": [
    { "path": "../../packages/epistemic" }
  ]
}
