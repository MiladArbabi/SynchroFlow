{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "module": "ESNext",
    "jsx": "react-jsx",

    "declaration": true,
    "sourceMap": true,

    "noEmit": false,
    "emitDeclarationOnly": false,
    "composite": true,

    "allowImportingTsExtensions": false
  },
  "include": [
    "src/**/*", 
    "../shared/src/contracts.ts"  ],
  "references": [
    { "path": "../../packages/epistemic" }
  ]
