{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    /**
    * Standardized ESM mode for monorepo consistency.
    * Required for correct package "exports" resolution.
    */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",

    "declaration": true,
    "sourceMap": true,

    "noEmit": false,
    "emitDeclarationOnly": false,
    "composite": true,

    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*", "../shared/src/contracts.ts"]
}
