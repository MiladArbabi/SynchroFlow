{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "Node16",
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false,           
    "emitDeclarationOnly": false,  
    "composite": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*", "../shared/src/contracts.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.*"]
}
