{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "composite": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowJs": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "isolatedModules": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules", 
    "dist", 
    "**/*.spec.ts", 
    "../../modules/*/src/ui/**/*"
  ],
  "references": [
    { "path": "../../packages/backend-core" }
  ]
}
