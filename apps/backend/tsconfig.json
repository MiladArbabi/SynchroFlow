{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowJs": true,
    "rootDir": "../..",
    "outDir": "./dist",
    "baseUrl": "../..",
    "paths": {
      "api-src/*": ["apps/backend/src/*"],
      "api-db": ["apps/backend/src/db.ts"],
      "api-types": ["apps/backend/src/types.ts"],
      "api-server": ["apps/backend/src/server.ts"],

      /* module-level alias for specter sources used by backend tests & providers */
      "modules-specter/*": ["modules/specter/src/*"],
      "modules-specter": ["modules/specter/src/index.ts"],

      /* shared package (prefer source for type-checking, fallback to dist for runtime) */
      "@lasyncro/shared/*": ["modules/shared/src/*", "modules/shared/dist/*"],
      "@lasyncro/shared": ["modules/shared/src/index.ts", "modules/shared/dist/index.js"]
    },
    "sourceMap": true,
    "declaration": false,
    "incremental": false,
    "isolatedModules": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../modules/shared/src/contracts/**/*.ts",
    "../../modules/shared/src/modules/**/*.ts",
    "../../modules/shared/src/ui-contracts.ts",
    "../../modules/specter/src/**/*.ts",
  ],
  "exclude": [
    "node_modules", 
    "dist", 
    "**/*.spec.ts", 
    "../../modules/*/src/ui/**/*"
  ]
}
