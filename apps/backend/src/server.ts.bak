import { getMyEntitlements } from './api/entitlements/entitlements.controller';
// Specter session-store (Redis-backed) lifecycle helpers
// Note: path points at the source module in the monorepo. This matches our runtime/node-start.tsconfig mapping.
import { initRedisSessionStore, closeRedisSessionStore } from '../../../modules/specter/src/store/session-store-redis';
import { closeQueue } from './queue';

const app: Express = express();
app.use(express.json());

// --- TO FIX FLY DEPLOY ---
const PGStore = connectPgSimple(session);
const sessionStore = new PGStore({
  conObject: db.client.config.connection, // <-- Give it the connection object
  tableName: 'user_sessions',
});

app.use(cookieParser() as any);
app.use(
  session({
    store: sessionStore,
    secret: process.env.SESSION_SECRET || 'fallback-secret-please-set-in-prod',
    resave: false,
    saveUninitialized: false,
    cookie: {
      secure: process.env.NODE_ENV === 'production',
      httpOnly: true,
      maxAge: 1000 * 60 * 60 * 24 * 7,
    },
  }) as any
);

// Register all our business rules
koreEngine.registerRule(staleOrderRule);
// koreEngine.registerRule(lowInventoryRule);

// Start the engine's cron jobs
koreEngine.start();

// --- 3.5 Optional: initialize Specter Redis-backed session store (if enabled) ---
// We initialize it early so any incoming ingestion code has a ready store.
// This is intentionally not `await`ed at top-level module load; we'll await before listening below.
let specterStoreInstance: any = null;
const maybeInitSpecterStore = async () => {
  if ((process.env.SPECTER_SESSION_STORE || '').toLowerCase() === 'redis') {
    try {
      specterStoreInstance = await initRedisSessionStore();
      console.log('[server] Specter Redis session store initialized');
    } catch (err) {
      console.warn('[server] Failed to initialize Specter Redis session store — continuing with in-memory store', (err && (err as Error).message) || err);
    }
  } else {
    // no-op: default in-memory store will be used by Specter modules
  }
};

// Determine port/host
const port = Number(process.env.PORT) || 3000;
const HOST = process.env.HOST || '127.0.0.1';

// Integrate the new layout routes
app.use("/api/v1/layouts", layoutRoutes);
app.use("/api/v1/orders", orderRoutes);
app.use("/api/v1/customers", customerRoutes);
app.use("/api/v1/integrations", integrationRoutes);
app.use("/api/v1/products", productsRoutes);
app.use("/api/v1/product-costs", productCostsRoutes);
app.use("/api/v1/auth", authRoutes);
app.use("/api/v1/dashboard", dashboardRoutes);
app.use("/api/v1/user-state", userStateRoutes);
app.use("/api/v1/shopify", shopifyRoutes);
app.use("/api/v1/onboarding", onboardingReadinessRouter);

app.get('/api/v1/entitlements/me', getMyEntitlements);

// Start HTTP server (mirrors running node dist/server.js directly)
const server = app.listen(port, HOST, async () => {
  // Ensure optional pieces are ready before we declare the app listening
  await maybeInitSpecterStore();

  console.log(`Server is listening on http://${HOST}:${port}`);

  // Lazily start workers if available relative to the discovered server dir
  const tryStart = async (modulePath, fnName) => {
    try {
      const resolved = path.resolve(serverDir, modulePath);
      if (!fs.existsSync(resolved)) {
        console.warn(`Worker not found at ${resolved} (skipping)`);
        return;
      }
      const mod = require(resolved);
      const fn = mod && (mod[fnName] || mod.default && mod.default[fnName]);
      if (typeof fn === 'function') {
        await fn();
        console.log(`Started ${modulePath} -> ${fnName}()`);
      } else {
        if (typeof mod.startWorker === 'function') {
          await mod.startWorker();
          console.log(`Started ${modulePath} -> startWorker()`);
        } else if (typeof mod.startSyncWorker === 'function') {
          await mod.startSyncWorker();
          console.log(`Started ${modulePath} -> startSyncWorker()`);
        } else {
          console.warn(`No known start function in ${modulePath} (module exported keys: ${Object.keys(mod).join(', ')})`);
        }
      }
    } catch (err) {
      console.error(`Failed to start worker ${modulePath}:`, err && err.message ? err.message : err);
    }
  };

  // try queue/worker modules emitted in dist (relative to server dir)
  await tryStart('worker.js', 'startWorker');
  await tryStart('sync.worker.js', 'startSyncWorker');
});

// Graceful shutdown: ensure Redis specter-store and queue are closed
const gracefulShutdown = async (sig?: string) => {
  console.log('[server] Received shutdown signal', sig || '');
  try {
    if (specterStoreInstance) {
      await closeRedisSessionStore(specterStoreInstance);
      console.log('[server] Specter Redis session store closed');
    }
  } catch (err) {
    console.warn('[server] Error closing specter redis store', err && (err as Error).message ? (err as Error).message : err);
  }

  try {
    await closeQueue();
    console.log('[server] Queue closed');
  } catch (err) {
    console.warn('[server] Error closing queue', err && (err as Error).message ? (err as Error).message : err);
  }

  try { server.close(() => { console.log('[server] HTTP server closed'); process.exit(0); }); } catch (_) { process.exit(0); }
};

process.on('SIGINT', () => gracefulShutdown('SIGINT'));
process.on('SIGTERM', () => gracefulShutdown('SIGTERM'));

// --- Routes ---
app.get('/', (req, res) => {
  res.send('SynchroFlow API is running!');
});

// --- THE DUMB HEALTH CHECK ---
