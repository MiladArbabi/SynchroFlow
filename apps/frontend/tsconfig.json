{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["jest", "@testing-library/jest-dom", "vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,

    // ---- IMPORTANT PART ----
    "baseUrl": "src",
    "paths": {
      "config": ["config.ts"],
      "hooks/*": ["hooks/*"],
      "themes/*": ["themes/*"],
      "utils/*": ["utils/*"],
      "ui-component/*": ["ui-component/*"],
      "layout/*": ["layout/*"],
      "menu-items": ["menu-items/index.ts"],
      "menu-items/*": ["menu-items/*"],
      "api/*": ["api/*"],
      "assets/*": ["assets/*"],
      "components/*": ["components/*"],
      "contexts/*": ["contexts/*"],
      "layouts/*": ["layouts/*"],
      "routes": ["routes.tsx"],
      "@lasyncro/shared/ui": ["../../../modules/shared/src/ui/index.ts"],
      "@lasyncro/order-nexus": ["modules/order-nexus/src/ui/index.ts"],
      "@lasyncro/specter": ["modules/specter/src/ui/index.ts"],
      "@lasyncro/finances": ["modules/finances/src/ui/index.ts"],
    }
  },
  "include": [
   "src",
   "types"
  ], 
  // Exclude test-only files from the main build/test-run typecheck to reduce noise.
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests",
    "test-results",
    "playwright-report"
  ],
}
